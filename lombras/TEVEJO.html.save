<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Procuro</title>
    <link rel="stylesheet" href="../style.css">
    <style>
        body { background-image: url('../assets/images/principal-bg.png'), url('../assets/images/textura-ruido.png'); }
        .audio-player-box {
            background-color: #24b7d1; 
            padding: 10px;
            border-radius: 5px;
            margin-bottom: 20px; 
            text-align: center;
        }
        .audio-player-box audio {
            width: 100%;
            max-width: 300px;
            margin-top: 5px;
        }
    </style>
</head>
<body class="bg-fixed">
    <div class="page-container">
        <div class="main-box-container">
            <div class="fita-canto-se"></div>
            <div class="fita-canto-sd"></div>
            <div class="fita-canto-ie"></div>
            <div class="fita-canto-id"></div>
            <div class="main-box">
                <header class="box-header"><h1>Mudança de Maré</h1></header>
                <main class="box-body">
                    <nav class="nav-grid"><a href="./index.html" class="nav-button"><span>VOLTAR P/ LOMBRAS</span></a></nav>

                    <div class="audio-player-box">
                        <p style="color: rgb(2, 2, 2); margin-bottom: 5px;">Chama eu, chama eu, chama eu Angola</p>
                        <audio controls><source src="../assets/audio/solo.mp3" type="audio/mpeg"></audio>
                    </div>

                    <article class="texto-principal">
                    </article>
                </main>
                <footer class="box-footer"><p>ENTRY:VIVERÉMANERO.log</p></footer>
            </div>
        </div>
    </div>
    <footer>Jomaserver</footer>
</body>
